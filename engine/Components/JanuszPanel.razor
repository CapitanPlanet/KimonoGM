<div class="janusz-panel">
    <img src="@GameState.JanuszImage" class="janusz-avatar" />
    <div class="stats">
        @foreach(var def in GameState.StatDefs)
        {
            <div class="stat-line">@def.name: @GameState.Stats.Get(def.id) @(def.id=="d"?"zł":"")</div>
        }
    </div>
    <div class="panel-audio">
        <AudioControls />
    </div>
</div>

<style>
.janusz-panel {
    position: absolute;
    top: 20px;
    left: 20px;
    width: 250px;
    background: rgba(0,0,0,0.9);
    border: 3px solid #8b6f47;
    padding: 10px;
    z-index: 40;
    color: #d4c5a0;
    font-family: 'Courier New';
    font-size: 11px;
}
.janusz-avatar {
    width: 100%;
    height: 140px;
    object-fit: cover;
    object-position: top center;
    border: 2px solid #8b6f47;
    display: block;
}
.stats { margin-top: 6px; }
.stat-line { padding: 2px 0; border-bottom: 1px dashed #2a241a; }

/* AUDIO W ŚRODKU JANUSZA - MA BYĆ RELATIVE, NIE ABSOLUTE */
.janusz-panel.panel-audio {
    position: relative;
    top: auto;
    right: auto;
    left: auto;
    margin-top: 8px;
    border-top: 1px solid #8b6f47;
    padding-top: 8px;
    display: flex;
    justify-content: flex-start;
    background: transparent;
    border-left: none;
    border-right: none;
    border-bottom: none;
    border-radius: 0;
}

/* Jeśli AudioControls jest gdzieś indziej jako standalone */
.volume-panel {
    position: absolute;
    top: 20px;
    right: 20px;
    z-index: 60;
    display: flex;
    gap: 14px;
    background: rgba(0,0,0,0.9);
    border: 2px solid #8b6f47;
    border-radius: 12px;
    padding: 8px 12px;
}

@@media (max-width: 768px) {
  .janusz-panel {
        top: 70px;
        left: 10px;
        width: 190px;
        padding: 6px;
        z-index: 30;
   }
  .janusz-avatar { height: 95px; }

   /* na mobile audio dalej w środku panelu, ale większe */
  .janusz-panel.panel-audio {
        padding-top: 10px;
   }
}
</style>

@code {
    [Parameter] public GameState GameState { get; set; } = default!;
}