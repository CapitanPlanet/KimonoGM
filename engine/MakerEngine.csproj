<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);Tools\**;bin\**;obj\**;wwwroot\**\.keep;wwwroot\**\.gitkeep</DefaultItemExcludes>
    <GameAssetsRoot Condition="'$(GameAssetsRoot)' == ''">Assets</GameAssetsRoot>
    <PublishTrimmed>false</PublishTrimmed>
    <BlazorWebAssemblyEnableTrimming>false</BlazorWebAssemblyEnableTrimming>
    <PublishTrimmed Condition="'$(Configuration)'=='Release'">false</PublishTrimmed>
    <BlazorWebAssemblyEnableTrimming Condition="'$(Configuration)'=='Release'">false</BlazorWebAssemblyEnableTrimming>
    <TrimMode>full</TrimMode>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <BlazorEnableCompression>false</BlazorEnableCompression>
    <CompressionEnabled>false</CompressionEnabled>
    <BlazorWebAssemblyEnableCompression>false</BlazorWebAssemblyEnableCompression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <GameImages Include="$(GameAssetsRoot)\images\**\*.*" />
    <SoundFiles Include="$(GameAssetsRoot)\sounds\**\*.*" Condition="Exists('$(GameAssetsRoot)\sounds')" />
    <DataFiles Include="$(GameAssetsRoot)\Data\**\*.*" />
    <DataFiles Include="$(GameAssetsRoot)\data\**\*.*" Condition="Exists('$(GameAssetsRoot)\data')" />
    <DataFiles Include="$(GameAssetsRoot)\*.janproj" />
    <DataFiles Include="$(GameAssetsRoot)\*.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot\**\.keep" />
    <Content Remove="wwwroot\**\.gitkeep" />
    <None Remove="wwwroot\**\.keep" />
    <None Remove="wwwroot\**\.gitkeep" />
    <StaticWebAsset Remove="wwwroot\**\.keep" />
    <StaticWebAsset Remove="wwwroot\**\.gitkeep" />
  </ItemGroup>

  <Target Name="JanuszClean" BeforeTargets="PrepareForBuild;ResolveStaticWebAssetsInputs;BeforeBuild">
    <ItemGroup>
      <OldDataFiles Include="wwwroot\data\**\*" />
      <OldImages Include="wwwroot\images\**\*" />
      <OldImages2 Include="wwwroot\Images\**\*" />
      <OldSounds Include="wwwroot\sounds\**\*" />
    </ItemGroup>
    <Delete Files="@(OldDataFiles)" Condition="Exists('wwwroot\data')" />
    <Delete Files="@(OldImages)" Condition="Exists('wwwroot\images')" />
    <Delete Files="@(OldImages2)" Condition="Exists('wwwroot\Images')" />
    <Delete Files="@(OldSounds)" Condition="Exists('wwwroot\sounds')" />
    <Delete Files="wwwroot\data\.keep;wwwroot\data\.gitkeep;wwwroot\images\.keep;wwwroot\sounds\.keep" />
  </Target>

  <Target Name="CopyGameAssets" BeforeTargets="PrepareForBuild;BeforeBuild" DependsOnTargets="JanuszClean">
    <MakeDir Directories="wwwroot\images;wwwroot\Images;wwwroot\data;wwwroot\sounds" />
    <Copy SourceFiles="@(GameImages)" DestinationFolder="wwwroot\images\%(RecursiveDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(GameImages)" DestinationFolder="wwwroot\Images\%(RecursiveDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(SoundFiles)" DestinationFolder="wwwroot\sounds\%(RecursiveDir)" SkipUnchangedFiles="false" Condition="Exists('$(GameAssetsRoot)\sounds')" />
    <Copy SourceFiles="@(DataFiles)" DestinationFolder="wwwroot\data\%(RecursiveDir)" SkipUnchangedFiles="false" />
    <!-- FIX: kopiuj project.janproj W SZYBKO wszędzie gdzie gra może go szukać -->
    <Copy SourceFiles="$(GameAssetsRoot)\project.janproj" DestinationFolder="wwwroot" SkipUnchangedFiles="false" Condition="Exists('$(GameAssetsRoot)\project.janproj')" />
    <Copy SourceFiles="$(GameAssetsRoot)\project.janproj" DestinationFolder="wwwroot\data" SkipUnchangedFiles="false" Condition="Exists('$(GameAssetsRoot)\project.janproj')" />
    <Copy SourceFiles="$(GameAssetsRoot)\Data\project.janproj" DestinationFolder="wwwroot" SkipUnchangedFiles="false" Condition="Exists('$(GameAssetsRoot)\Data\project.janproj')" />
    <Copy SourceFiles="$(GameAssetsRoot)\Data\project.janproj" DestinationFolder="wwwroot\data" SkipUnchangedFiles="false" Condition="Exists('$(GameAssetsRoot)\Data\project.janproj')" />
    <Copy SourceFiles="$(GameAssetsRoot)\data\project.janproj" DestinationFolder="wwwroot" SkipUnchangedFiles="false" Condition="Exists('$(GameAssetsRoot)\data\project.janproj')" />
    <Copy SourceFiles="$(GameAssetsRoot)\data\project.janproj" DestinationFolder="wwwroot\data" SkipUnchangedFiles="false" Condition="Exists('$(GameAssetsRoot)\data\project.janproj')" />
    <Message Text="COPIED FROM $(GameAssetsRoot) -> wwwroot: @(DataFiles)" Importance="high" />
  </Target>

  <Target Name="EnsureDataPlaceholder" AfterTargets="CopyGameAssets" BeforeTargets="ResolveStaticWebAssetsInputs">
    <MakeDir Directories="wwwroot\data" />
  </Target>

  <Target Name="DeleteBrotliForItch" AfterTargets="Publish">
    <ItemGroup>
      <ItchBrFiles Include="$(PublishDir)wwwroot\_framework\**\*.br" />
      <ItchGzFiles Include="$(PublishDir)wwwroot\_framework\**\*.gz" />
      <ItchBrFiles2 Include="$(PublishDir)wwwroot\**\*.br" />
      <ItchGzFiles2 Include="$(PublishDir)wwwroot\**\*.gz" />
    </ItemGroup>
    <Delete Files="@(ItchBrFiles)" />
    <Delete Files="@(ItchGzFiles)" />
    <Delete Files="@(ItchBrFiles2)" />
    <Delete Files="@(ItchGzFiles2)" />
    <Message Text="DELETED .br/.gz FOR ITCH.IO" Importance="high" />
  </Target>
</Project>