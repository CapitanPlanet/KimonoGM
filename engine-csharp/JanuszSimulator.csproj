<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);Tools\**</DefaultItemExcludes>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <GameImages Include="Assets\GameImages\**\*.*" />
    <GameImages Include="Assets\images\**\*.*" />
    <GameImages Include="..\games\10003\images\**\*.*" />
    <SoundFiles Include="Assets\sounds\**\*.*" />
    <!-- BEZ Exclude na day*.json - chcemy czyste day1, day2 -->
    <DataFiles Include="Assets\data\**\*.*" Exclude="Assets\data\mielno_ending.json" />
  </ItemGroup>

  <!-- USUNIĘTE CleanGameImagesBeforeBuild - to kasowało Ci bg_front i robiło 404 -->

  <Target Name="CopyGameAssets" BeforeTargets="BeforeBuild">
    <MakeDir Directories="wwwroot\images;wwwroot\Images;wwwroot\data;wwwroot\sounds" />
    <Copy SourceFiles="@(GameImages)" DestinationFolder="wwwroot\Images\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(GameImages)" DestinationFolder="wwwroot\images\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(SoundFiles)" DestinationFolder="wwwroot\sounds\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DataFiles)" DestinationFolder="wwwroot\data\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Assets -> wwwroot: GameImages, sounds, data SKOPIOWANE (bez bundla)" />
  </Target>

  <!-- USUNIĘTE BundleDaysToScenes - nie lepimy plików -->

</Project>