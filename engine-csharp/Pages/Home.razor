@page "/"
@inject GameEngine GameEngine
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Janusz Simulator 97</PageTitle>

<div class="piwo-placeholder" @onclick="PostawPiwoClick">
    <span class="piwo-ikona">🍺</span>
    <span class="piwo-text">Postaw Januszowi piwo</span>
    <span class="piwo-cena">3zł</span>
</div>

@if (GameEngine.GameState != null)
{
    <div class="game-container" @onclick="CloseDrawer">
        <img src="@GameEngine.GameState.BackgroundImage" class="background" />
        
        <div @onclick:stopPropagation="true">
            <JanuszPanel GameState="GameEngine.GameState" />
        </div>

        @if (!string.IsNullOrWhiteSpace(GameEngine.GameState.ReactionText))
        {
            <div class="reaction-overlay" @onclick="SkipReaction">
                @if (!string.IsNullOrWhiteSpace(GameEngine.GameState.ReactionImage))
                {
                    <img src="@GameEngine.GameState.ReactionImage" alt="Janusz" />
                }
                <div class="reaction-text">@GameEngine.GameState.ReactionText</div>
            </div>
        }

        <div class="bottom-ui @(showChoices ? "open" : "")" @onclick:stopPropagation="true">
            <div class="narration-box">
                <div class="scene-title">@GameEngine.GameState.SceneTitle</div>
                <p class="narration-text">@GameEngine.GameState.NarrationText</p>
            </div>
            <div class="choices-container desktop-only">
                @if (!GameEngine.GameState.IsFinished)
                {
                    @foreach (var choice in GameEngine.GetAvailableChoices())
                    {
                        <button class="choice-btn" @onclick="() => MakeChoice(choice)">@choice.Text</button>
                    }
                }
                else
                {
                    <button class="choice-btn restart-btn" @onclick="RestartGame">▶ GRAJ PONOWNIE</button>
                    <button class="choice-btn" @onclick="ShowStats">📊 STATYSTYKI KOŃCOWE</button>
                }
            </div>
        </div>

        <div class="mobile-choice-handle" @onclick:stopPropagation="true" @onclick="ToggleChoices">
            <span>@(showChoices ? "▼ Schowaj" : $"▲ {(GameEngine.GameState.IsFinished ? "KONIEC GRY" : $"Wybierz akcję ({GameEngine.GetAvailableChoices().Count()})")}")</span>
        </div>

        <div class="choices-drawer @(showChoices ? "open" : "")" @onclick:stopPropagation="true">
            <div class="drawer-header" @onclick="ToggleChoices"><div class="drag-bar"></div></div>
            
            <div class="narration-box drawer-narration">
                <div class="scene-title">@GameEngine.GameState.SceneTitle</div>
                <p class="narration-text">@GameEngine.GameState.NarrationText</p>
            </div>

            <div class="choices-container mobile-only">
                @if (!GameEngine.GameState.IsFinished)
                {
                    @foreach (var choice in GameEngine.GetAvailableChoices())
                    {
                        <button class="choice-btn" @onclick="async () => { showChoices = false; await MakeChoice(choice); }">@choice.Text</button>
                    }
                }
                else
                {
                    <button class="choice-btn restart-btn" @onclick="async () => { showChoices = false; await RestartGame(); }">▶ GRAJ PONOWNIE</button>
                    <button class="choice-btn" @onclick="() => { showChoices = false; ShowStats(); }">📊 STATYSTYKI KOŃCOWE</button>
                }
            </div>
        </div>
    </div>

    <div class="tvp-ticker"><div class="ticker-content"><span>@GetTickerNews()</span></div><AudioControls /></div>
}

@code {
    private bool showChoices = false;
    private System.Threading.Timer? narratorTimer;
    private Random rnd = new Random();
    private bool gameStarted = false;

    private void ToggleChoices() => showChoices = !showChoices;
    private void CloseDrawer() { if (showChoices) showChoices = false; }

    private async Task PostawPiwoClick() => await JS.InvokeVoidAsync("open", "https://tipply.pl/@kapitanplaneta", "_blank");
    
    private string GetTickerNews() {
        if (GameEngine.GameState == null) return "TVP1 - WIADOMOSCI";
        var s = GameEngine.GameState.Stats; 
        var defs = GameEngine.GameState.StatDefs; 
        var scene = GameEngine.GameState.CurrentScene?.Id ?? "";
        var news = new List<string> { "PILNE: Janusz wyszedl z domu o 6:47" };
        foreach(var d in defs) news.Add($"{d.name}: {s.Get(d.id)}pkt");
        if (scene.Contains("tramwaj")) news.Add("KOMUNIKACJA: Awantura w tramwaju linii 10");
        if (scene.Contains("biedronka")) news.Add("GOSPODARKA: Parowki w promocji -12zl");
        if (scene.Contains("praca")) news.Add("PRZEMYSL: Tasma stanela, Janusz naprawia");
        if (scene.Contains("szef")) news.Add("BIZNES: Premia czy parowki?");
        if (scene.Contains("kebab")) news.Add("IMIGRACJA: Turek podniosl ceny");
        if (scene.Contains("urzad")) news.Add("PODATKI: Janusz sklada PIT");
        if (scene.Contains("blok")) news.Add("SPOLECZENSTWO: Sasiadka skarży sie na smietnik");
        if (scene.Contains("wieczor")) news.Add("RODZINA: Grażyna żąda wypłaty");
        // FIX: używaj normalizowanych ID zamiast "a", "d"
        if (s.Get("CEBULA") > 50) news.Add("SUKCES: Janusz mistrzem cebuli");
        if (s.Get("PORTFEL") < 50) news.Add("BIEDA: Portfel swieci pustkami");
        if (s.Get("WSTYD") > 70) news.Add("WSTYD: Sąsiedzi patrzą krzywo");
        news.Add("POGODA: -5C, otwieraj okna"); news.Add("SPORT: Reprezentacja przegrala"); news.Add("TVP: Za chwile Teleexpress");
        return string.Join(" *** ", news);
    }

    private async Task MakeChoice(Choice choice) {
        if (!gameStarted) 
        { 
            gameStarted = true; 
        }
        await GameEngine.MakeChoice(choice);
    }

    private void SkipReaction() => GameEngine.SkipReaction();

    private async Task RestartGame() { 
        try { await JS.InvokeVoidAsync("JanuszAudio.stopMusic"); } catch {}
        try { await JS.InvokeVoidAsync("JanuszAudio.playVoice", ""); } catch {}
        gameStarted = false; 
        await GameEngine.LoadGame(); 
    }


    private void ShowStats() {
        var s = GameEngine.GameState.Stats; 
        var defs = GameEngine.GameState.StatDefs; 
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("KONIEC DNIA JANUSZA:\n"); 
        foreach(var d in defs) sb.AppendLine($"{d.name}: {s.Get(d.id)}");
        // FIX: też normalizowane ID
        var cebula = s.Get("CEBULA");
        sb.AppendLine($"\nGrazyna jest {(cebula > 30 ? "DUMNA" : "WKURWIONA")}.");
        GameEngine.GameState.NarrationText = sb.ToString(); 
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync() { await GameEngine.LoadGame(); GameEngine.StateChanged += OnStateChanged; }
    private void OnStateChanged() => InvokeAsync(StateHasChanged);



    public void Dispose() { GameEngine.StateChanged -= OnStateChanged; }
}
