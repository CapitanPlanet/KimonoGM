@using MakerEngine.Models

@if (Choice!= null)
{
    <div class="reaction-screen" @onclick="OnSkip" style="cursor: pointer;">
        @if (!string.IsNullOrEmpty(Choice.ReactionImage))
        {
            <img src="@Choice.ReactionImage" alt="Reakcja" />
        }
        <div class="reaction-text">
            @Choice.ReactionText
        </div>
        <div style="margin-top: 15px; font-size: 14px; color: #888;">
            Kliknij żeby pominąć...
        </div>
    </div>
}

<style>
   .reaction-screen {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        text-align: center;
        animation: fadeIn 0.3s;
        user-select: none;
        -webkit-user-select: none;
    }

   .reaction-screen img {
        max-width: 90%;
        max-height: 50vh;
        object-fit: contain;
        border: 4px solid #d4a017;
        margin-bottom: 20px;
    }

   .reaction-text {
        background: #2a2a2a;
        padding: 20px 30px;
        border: 3px solid #d4a017;
        font-size: 20px;
        color: #d4a017;
        max-width: 80%;
    }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
</style>

@code {
    [Parameter] public Choice? Choice { get; set; }
    [Parameter] public EventCallback OnSkip { get; set; }
}